// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
model RevokedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum UserStatus {
  ATIVO
  INATIVO
}

enum UserProfile {
  ADOTANTE
  VOLUNTARIO
  ADMIN
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  password String
  cpf String @unique
  phone String?
  birthday DateTime @db.Date
  status UserStatus @default(ATIVO)
  profile UserProfile @default(ADOTANTE)
  adoption Adoption[]
  visit Visit[]
  donation Donation[]
}

model Shelter {
  id Int @id @default(autoincrement())
  name String
  cnpj String @unique
  address String @unique
  phone String @unique
  email String @unique
  maxCapacity Int
  workingHours String
  atendeeLimit Int
  visit Visit[]
  donation Donation[]
  animals Animal[]
}

model Species {
  id Int @id @default(autoincrement())
  name String
  description String?
  race Race[]
}

enum Size {
  PEQUENO
  MEDIO
  GRANDE
}

model Race {
  id Int @id @default(autoincrement())
  name String
  size Size
  speciesId Int
  species Species @relation(fields: [speciesId], references: [id])
  animal Animal[]
}

enum Sex {
  MACHO
  FEMEA
}

enum AnimalStatus {
  DISPONIVEL
  EM_PROCESSO
  ADOTADO
  INATIVO
}

model Animal {
  id Int @id @default(autoincrement())
  name String
  sex Sex
  birthday DateTime @db.Date
  description String?
  status AnimalStatus @default(DISPONIVEL)
  raceId Int
  race Race @relation(fields: [raceId], references: [id])
  medicalRecord MedicalRecord[]
  adoption Adoption?
  animalImage AnimalImage[]
    shelterId Int?
  shelter Shelter? @relation(fields: [shelterId], references: [id])
}

enum RecordType {
  VACINA
  CONSULTA
  CASTRACAO
  EXAME
}

model MedicalRecord {
  id Int @id @default(autoincrement())
  animalId Int
  type RecordType
  description String
  date DateTime @db.Date
  vaterinaryName String
  animal Animal @relation(fields: [animalId], references: [id])
}

enum AdoptionStatus {
  PENDENTE
  EM_ANALISE
  APROVADO
  REJEITADO
  CANCELADO
}

model Adoption {
  id Int @id @default(autoincrement())
  userId Int
  animalId Int @unique
  status AdoptionStatus @default(PENDENTE)
  observation String?
  adoptionDate DateTime @db.Date
  user User @relation(fields: [userId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])
}

enum VisitStatus {
  AGENDADA
  CONFIRMADA
  CANCELADA
}

model Visit {
  id Int @id @default(autoincrement())
  userId Int
  shelterId Int
  visitDate DateTime @db.Date
  status VisitStatus @default(AGENDADA)
  user User @relation(fields: [userId], references: [id])
  shelter Shelter @relation(fields: [shelterId], references: [id])
}

enum DonationType {
  RACAO
  DINHEIRO
  MEDICAMENTO
  OUTRO
}

model Donation {
  id Int @id @default(autoincrement())
  userId Int
  shelterId Int
  type DonationType
  value Int?
  description String?
  user User @relation(fields: [userId], references: [id])
  shelter Shelter @relation(fields: [shelterId], references: [id])
}

model AnimalImage {
  id Int @id @default(autoincrement())
  animalId Int
  imageUrl String
  animal Animal @relation(fields: [animalId], references: [id])
}